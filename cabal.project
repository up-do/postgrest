import: ./project-stackage/lts-24.48.config

-- We have 1 package.
packages:
    .

-- Version equality constraints.
constraints:
    aeson-jsonpath ==0.4.2.0
  , botan-bindings ==0.3.0.0
  , botan-low ==0.2.0.1
  , configurator-pg ==0.2.11
  , fuzzyset ==0.2.4
  , hasql-notifications ==0.2.4.0
  , http-semantics ==0.4.0
  , http2 ==5.4.0
  , jose-jwt-botan ==0.13.0
  , warp ==3.4.14
tests: true
allow-newer:
  , fuzzyset:data-default
  , fuzzyset:text
  , hasql:postgresql-libpq

-- https://github.com/martijnbastiaan/doctest-parallel/blob/main/example/README.md#cabalproject
write-ghc-environment-files: always

